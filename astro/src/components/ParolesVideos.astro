---
// Titre + intro, puis des vidéos : grille de 3 colonnes à partir de 768px, carrousel infini
// (glisser, flèches, pastilles) en dessous, puis un bouton d'appel à l'action. Version
// composant du bloc pages/equipe/blocs/05-paroles.html (même rendu, même comportement,
// couleurs lues dans les tokens --wf-*).
interface Video {
  src: string;
  titre: string; // title de l'iframe (accessibilité)
  legende: string; // texte affiché sous la vidéo
}
interface Props {
  titre: string; // sans le point final : il est ajouté en dégradé orange
  intro: string; // HTML autorisé (<em>)
  videos: Video[];
  ctaTexte: string;
  ctaLien: string;
  id?: string;
}
const { titre, intro, videos, ctaTexte, ctaLien, id = 'wt-paroles' } = Astro.props;

const CDN = 'https://cdn.prod.website-files.com/63d687e3cca00b36190024ea/';
const flecheGauche = `${CDN}63eabf64b5d45c38647886aa_Arrow5.svg`;
const flecheDroite = `${CDN}63eabfbda7b0471dbc86a3ec_Arrow-Right.svg`;

const ALLOW_GRILLE = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
const ALLOW_CLONE = 'accelerometer; encrypted-media';
const total = videos.length;
// Piste du carrousel = [clone de la dernière, vidéos..., clone de la première] : le script saute
// d'un clone à la vraie vidéo correspondante une fois l'animation finie (boucle infinie).
const premiere = videos[0];
const derniere = videos[total - 1];
---

<section class="wt-paroles" id={id} aria-labelledby={`${id}-title`}>
  <h2 class="wt-title" id={`${id}-title`}>{titre}<span class="wt-title-dot">.</span></h2>
  <p class="wt-intro" set:html={intro} />

  <div class="wt-grid">
    {
      videos.map((v) => (
        <div class="wt-square">
          <div class="wt-video-frame">
            <iframe src={v.src} title={v.titre} loading="lazy" frameborder="0" allow={ALLOW_GRILLE} allowfullscreen />
          </div>
          <div class="wt-caption">{v.legende}</div>
        </div>
      ))
    }
  </div>

  <div class="wt-carousel">
    <div class="wt-carousel-wrap">
      <button type="button" class="wt-arrow wt-arrow-left" data-dir="-1" aria-label="Vidéo précédente"><img src={flecheGauche} alt="" /></button>
      <div class="wt-carousel-viewport">
        <div class="wt-carousel-track">
          <div class="wt-slide" aria-hidden="true">
            <div class="wt-video-frame">
              <iframe src={derniere.src} title="" tabindex="-1" loading="lazy" frameborder="0" allow={ALLOW_CLONE} allowfullscreen />
            </div>
            <div class="wt-caption">{derniere.legende}</div>
          </div>
          {
            videos.map((v, i) => (
              <div class="wt-slide" role="group" aria-label={`Vidéo ${i + 1} sur ${total}`}>
                <div class="wt-video-frame">
                  <iframe src={v.src} title={v.titre} loading="lazy" frameborder="0" allow={ALLOW_GRILLE} allowfullscreen />
                </div>
                <div class="wt-caption">{v.legende}</div>
              </div>
            ))
          }
          <div class="wt-slide" aria-hidden="true">
            <div class="wt-video-frame">
              <iframe src={premiere.src} title="" tabindex="-1" loading="lazy" frameborder="0" allow={ALLOW_CLONE} allowfullscreen />
            </div>
            <div class="wt-caption">{premiere.legende}</div>
          </div>
        </div>
      </div>
      <button type="button" class="wt-arrow wt-arrow-right" data-dir="1" aria-label="Vidéo suivante"><img src={flecheDroite} alt="" /></button>
    </div>
    <div class="wt-dots">
      {
        videos.map((_, i) => (
          <button type="button" class:list={['wt-dot', { 'is-active': i === 0 }]} data-index={i} aria-label={`Aller à la vidéo ${i + 1} sur ${total}`} />
        ))
      }
    </div>
  </div>

  <a class="wt-cta" href={ctaLien}>{ctaTexte}</a>
</section>

<style>
  .wt-paroles {
    font-family: "Work Sans v2", Arial, sans-serif;
    max-width: 71.25rem;
    margin: 0 auto 5rem;
    padding: 0 1rem;
    box-sizing: border-box;
  }
  .wt-paroles, .wt-paroles :global(*), .wt-paroles :global(*::before), .wt-paroles :global(*::after) { box-sizing: border-box; }

  /* Titre + intro : même traitement que les autres blocs (dégradé bleu + point
     orange). C'est d'ailleurs le titre de référence sur lequel ce dégradé a été
     mesuré au départ. Tous les textes du bloc sont centrés, desktop et mobile,
     à la demande explicite de Paul (le site réel aligne l'intro à gauche sur
     mobile, mais ce n'est pas ce qui est voulu ici). */
  .wt-title {
    font-family: Allroundgothic, Arial, sans-serif;
    font-size: 3.2rem;
    line-height: 3.84rem;
    font-weight: 400;
    letter-spacing: -0.128rem;
    text-align: center;
    margin: 0;
    background: linear-gradient(270deg, var(--wf-blue-800), var(--wf-blue-600));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .wt-title-dot {
    background: linear-gradient(var(--wf-orange-600), var(--wf-orange-500));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .wt-intro {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.3rem;
    color: var(--wf-blue-900);
    text-align: center;
    max-width: 50rem;
    margin: 1.125rem auto 3rem;
  }
  /* Le HTML de l'intro vient de `set:html` : d'où `:global` sur <em>. */
  .wt-intro :global(em) { font-style: italic; }

  @media screen and (max-width: 767px) {
    .wt-title { font-size: 3rem; line-height: 1; letter-spacing: -0.12rem; } /* design-system.md §2 : 3rem entre 480 et 767px, 2.5rem sous 480px (règle en bas de feuille) */
  }

  /* Grille desktop : reprise telle quelle du bloc natif du site (3 colonnes,
     vidéo en ratio padding-top:60% — pas le 16:9 utilisé ailleurs, c'est le vrai
     ratio du bloc d'origine — légende en dessous, alignée à gauche). Inchangée
     à la demande de Paul : seul le mobile est retravaillé. */
  .wt-grid {
    display: none;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .wt-video-frame { position: relative; width: 100%; padding-top: 60%; overflow: hidden; }
  .wt-video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .wt-caption {
    margin-top: 0.75rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--wf-blue-800);
    text-align: center;
  }
  @media screen and (min-width: 768px) {
    .wt-grid { display: grid; }
    .wt-carousel { display: none; }
  }

  /* Carrousel mobile : une seule vidéo pleine largeur et centrée par vue (pas
     d'amorce de la suivante), défilement infini (boucle) au doigt ou via les
     petits carrés de pagination en dessous — demande explicite de Paul, pattern
     différent du reste du bloc (qui reste identique au site). */
  .wt-carousel { margin-bottom: 3rem; }
  .wt-carousel-wrap { position: relative; }
  .wt-carousel-viewport { overflow: hidden; width: 100%; touch-action: pan-y; }
  .wt-carousel-track { display: flex; }
  .wt-slide { flex: 0 0 100%; width: 100%; min-width: 0; }

  /* Flèches : mêmes icônes/pastille que le reste du site (voir bloc collectif).
     Boucle infinie oblige, elles restent toujours visibles (jamais de "bout de
     course" à masquer). */
  .wt-arrow {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 2.8125rem;
    height: 2.8125rem;
    border-radius: 99px;
    background: var(--wf-blue-800);
    border: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    padding: 0;
  }
  .wt-arrow img { width: 1rem; height: 1rem; }
  .wt-arrow-left { left: -0.5rem; }
  .wt-arrow-right { right: -0.5rem; }

  .wt-dots { display: flex; justify-content: center; gap: 0.5rem; margin-top: 1.25rem; }
  .wt-dot {
    appearance: none;
    border: 0;
    padding: 0;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 0;
    background: var(--wf-grey-100);
    cursor: pointer;
  }
  .wt-dot.is-active { background: var(--wf-blue-600); }

  /* CTA : pilule dégradée orange, identique au bouton "REJOINS L'AVENTURE
     WEFIIT" du site réel. */
  .wt-cta {
    display: block;
    width: fit-content;
    margin: 0 auto;
    background: linear-gradient(to right, var(--wf-orange-500), var(--wf-orange-600));
    color: #fff;
    font-family: inherit;
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1.25rem;
    font-size: 1rem;
    text-decoration: none;
    text-align: center;
    padding: 1.0625rem 2.5rem;
    border-radius: 500px;
  }
  /* Mobile : bouton pleine largeur et texte centré, comme le bouton du site (design-system.md §6). */
  @media screen and (max-width: 767px) {
    .wt-cta { width: 100%; }
  }
  @media screen and (max-width: 479px) {
    .wt-title { font-size: 2.5rem; line-height: 1; letter-spacing: -0.1rem; }
  }
</style>

<script>
  // Carrousel mobile : défilement infini, glisser (Pointer Events), flèches et pastilles.
  document.querySelectorAll<HTMLElement>('.wt-paroles').forEach((root) => {
    if (root.getAttribute('data-wtp-init') === '1') return;
    root.setAttribute('data-wtp-init', '1');

    const viewport = root.querySelector<HTMLElement>('.wt-carousel-viewport')!;
    const track = root.querySelector<HTMLElement>('.wt-carousel-track')!;
    const dots = root.querySelectorAll<HTMLElement>('.wt-dot');
    const total = dots.length; // nombre de vraies vidéos
    const slideIframes = Array.from(track.querySelectorAll<HTMLElement>('.wt-slide')).map((slide) => {
      const iframe = slide.querySelector<HTMLIFrameElement>('iframe');
      // Vimeo, tube.rvere.com... chaque plateforme a sa propre API de contrôle (ou
      // aucune) : plutôt que de dépendre de l'une d'elles, on coupe la lecture en
      // rechargeant l'iframe (retour à about:blank puis à sa source d'origine),
      // ce qui fonctionne quelle que soit la vidéo.
      if (iframe) iframe.dataset.origSrc = iframe.getAttribute('src') ?? '';
      return iframe;
    });
    function stopVideoAt(index: number) {
      const iframe = slideIframes[index];
      if (!iframe || !iframe.dataset.origSrc) return;
      iframe.src = 'about:blank';
      iframe.src = iframe.dataset.origSrc;
    }
    // Piste = [clone de la dernière, vidéo 0, vidéo 1, vidéo 2, clone de la première]
    let pos = 1;
    let isAnimating = false;
    let pointerActive = false; // du pointerdown au pointerup/cancel, avant même de savoir si c'est un glisser
    let dragging = false; // seulement vrai une fois le seuil de déplacement dépassé (voir DRAG_THRESHOLD)
    let startX = 0;
    let deltaX = 0;
    const DRAG_THRESHOLD = 8; // px

    function setPosition(newPos: number, animate: boolean) {
      track.style.transition = animate ? 'transform 0.35s ease' : 'none';
      track.style.transform = 'translateX(' + -newPos * 100 + '%)';
      pos = newPos;
    }

    function updateDots() {
      const real = (pos - 1 + total) % total;
      dots.forEach((d, i) => d.classList.toggle('is-active', i === real));
    }

    function goTo(newPos: number) {
      if (isAnimating) return;
      if (newPos !== pos) stopVideoAt(pos); // coupe la vidéo de la slide qu'on quitte
      isAnimating = true;
      setPosition(newPos, true);
      updateDots();
    }

    setPosition(pos, false);
    updateDots();

    // Saut invisible (sans animation) d'un clone vers la vraie vidéo correspondante,
    // une fois l'animation de défilement terminée : c'est ce qui donne l'effet de
    // boucle infinie.
    track.addEventListener('transitionend', () => {
      isAnimating = false;
      if (pos === total + 1) setPosition(1, false);
      else if (pos === 0) setPosition(total, false);
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => goTo(i + 1));
    });

    root.querySelectorAll<HTMLElement>('.wt-arrow').forEach((arrow) => {
      arrow.addEventListener('click', () => {
        goTo(pos + parseInt(arrow.getAttribute('data-dir') ?? '0', 10));
      });
    });

    // Pointer Events (et non Touch Events) pour que le glisser fonctionne aussi
    // à la souris/trackpad (ex. en testant le rendu mobile sur un Chrome de
    // bureau redimensionné, où les événements tactiles ne se déclenchent jamais).
    //
    // Important : les slides contiennent des iframes vidéo. On ne doit engager
    // le glisser (et surtout ne JAMAIS appeler setPointerCapture) que si l'on a
    // détecté un vrai déplacement au-delà d'un petit seuil. Sinon, un simple
    // clic sur le bouton lecture de la vidéo était intercepté par le carrousel :
    // la vidéo ne démarrait jamais, et pire, la branche "pas de vrai glisser" du
    // endDrag posait isAnimating=true puis rejouait la même position via
    // setPosition — comme le transform ne changeait pas de valeur, aucun
    // transitionend ne se déclenchait, isAnimating restait bloqué à true pour
    // toujours, et goTo() (flèches et pastilles) ne faisait plus rien ensuite.
    viewport.addEventListener('pointerdown', (e) => {
      if (isAnimating) return;
      pointerActive = true;
      dragging = false;
      startX = e.clientX;
      deltaX = 0;
    });

    viewport.addEventListener('pointermove', (e) => {
      if (!pointerActive) return;
      deltaX = e.clientX - startX;
      if (!dragging) {
        if (Math.abs(deltaX) < DRAG_THRESHOLD) return;
        dragging = true;
        track.style.transition = 'none';
        viewport.setPointerCapture(e.pointerId);
      }
      const base = -pos * viewport.clientWidth;
      track.style.transform = 'translateX(' + (base + deltaX) + 'px)';
    });

    function endDrag() {
      if (!pointerActive) return;
      pointerActive = false;
      if (!dragging) return; // simple clic (ex. play sur la vidéo) : on ne touche à rien, il passe normalement
      dragging = false;
      const threshold = 40;
      if (deltaX < -threshold) goTo(pos + 1);
      else if (deltaX > threshold) goTo(pos - 1);
      else {
        isAnimating = true;
        setPosition(pos, true);
      }
    }

    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);
  });
</script>
