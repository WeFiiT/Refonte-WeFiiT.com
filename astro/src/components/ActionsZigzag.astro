---
// Titre centré + intro sur une bande gris clair pleine largeur, puis une liste d'actions en
// zigzag : texte et photo côte à côte, la photo alterne à droite puis à gauche. Reproduit
// la section « Agir et s'engager, ensemble » de /notre-engagement-rse (valeurs mesurées :
// fond rgb(245,247,250), conteneur 940px, photos 432×324, 20px entre deux lignes).
interface Action {
  titre: string;
  texte: string; // HTML autorisé (<br>)
  photo: string;
  alt: string;
}
interface Props {
  titre: string; // sans le point final : il est ajouté en dégradé orange
  intro: string; // HTML autorisé (<br>)
  actions: Action[];
  id?: string;
}
const { titre, intro, actions, id = 'wt-zigzag' } = Astro.props;
---

<section class="wt-zigzag" id={id} aria-labelledby={`${id}-titre`}>
  <div class="wt-bande">
    <div class="wt-inner">
      <h2 class="wt-titre" id={`${id}-titre`}>{titre}<span class="wt-point">.</span></h2>
      <p class="wt-intro" set:html={intro} />
      <ul class="wt-liste">
        {
          actions.map((a) => (
            <li class="wt-action">
              <div class="wt-texte">
                <h3 class="wt-action-titre">{a.titre}</h3>
                <p class="wt-action-texte" set:html={a.texte} />
              </div>
              <div class="wt-photo">
                <img src={a.photo} alt={a.alt} loading="lazy" />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .wt-zigzag { font-family: "Work Sans v2", Arial, sans-serif; margin: 0; box-sizing: border-box; }
  .wt-zigzag, .wt-zigzag :global(*), .wt-zigzag :global(*::before), .wt-zigzag :global(*::after) { box-sizing: border-box; }

  .wt-bande {
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    background: #f5f7fa;
    padding: 2.5rem 0 5rem;
  }
  .wt-inner { max-width: 58.75rem; margin: 0 auto; padding: 0 1rem; }

  .wt-titre {
    font-family: Allroundgothic, Arial, sans-serif;
    font-size: 3.2rem;
    line-height: 3.84rem;
    font-weight: 400;
    letter-spacing: -0.128rem;
    text-align: center;
    margin: 0;
    background: linear-gradient(270deg, var(--wf-blue-800), var(--wf-blue-600));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .wt-point {
    background: linear-gradient(var(--wf-orange-600), var(--wf-orange-500));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .wt-intro { margin: 1rem 0 2.5rem; font-size: 1rem; line-height: 1.5rem; color: var(--wf-blue-900); text-align: center; }

  .wt-liste { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .wt-action { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .wt-action:nth-child(even) { flex-direction: row-reverse; }
  .wt-photo { flex: 0 0 27rem; max-width: 27rem; aspect-ratio: 4 / 3; background: var(--wf-blue-50); box-shadow: rgba(150, 163, 181, 0.08) 0 4px 24px 0; }
  .wt-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .wt-texte { flex: 1 1 auto; padding: 0 2rem; max-width: 27rem; }
  .wt-action-titre { margin: 0 0 1rem; font-size: 1rem; line-height: 1.5rem; font-weight: 700; color: var(--wf-blue-800); text-align: left; }
  .wt-action-texte { margin: 0; font-size: 1rem; line-height: 1.5rem; color: var(--wf-blue-900); text-align: left; }

  @media screen and (max-width: 991px) {
    .wt-action, .wt-action:nth-child(even) { flex-direction: column; align-items: stretch; gap: 1.25rem; }
    .wt-photo { flex: none; max-width: none; width: 100%; }
    .wt-texte { padding: 0; max-width: none; }
    .wt-liste { gap: 2.5rem; }
  }
  @media screen and (max-width: 767px) {
    .wt-titre { font-size: 3rem; line-height: 1; }
    .wt-bande { padding-bottom: 3rem; }
  }
  @media screen and (max-width: 479px) {
    .wt-titre { font-size: 2.5rem; text-align: left; }
    .wt-intro { font-size: 0.9rem; text-align: left; }
  }
</style>
