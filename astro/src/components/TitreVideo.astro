---
// Titre H2 centré (dégradé bleu + point orange) suivi d'une vidéo YouTube pleine largeur.
// Version composant du bloc pages/equipe/blocs/02-wefiit-2025.html (même rendu, mêmes
// valeurs, couleurs lues dans les tokens --wf-*).
interface Props {
  titre: string; // sans le point final : il est ajouté en orange
  video: string; // URL de l'iframe YouTube
  titreVideo: string; // attribut title de l'iframe (accessibilité)
  id?: string;
}
const { titre, video, titreVideo, id = 'wt-2025' } = Astro.props;
---

<section class="wt-titre-video" id={id} aria-labelledby={`${id}-title`}>
  <h2 class="wt-title" id={`${id}-title`}>{titre}<span class="wt-title-dot">.</span></h2>

  <div class="wt-video-frame">
    <iframe src={video} title={titreVideo} loading="lazy" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
  </div>
</section>

<style>
  .wt-titre-video {
    font-family: "Work Sans v2", Arial, sans-serif;
    max-width: 71.25rem;
    margin: 0 auto 5rem;
    padding: 0 1rem;
    box-sizing: border-box;
  }
  .wt-titre-video, .wt-titre-video *, .wt-titre-video *::before, .wt-titre-video *::after { box-sizing: border-box; }

  /* Titre : même traitement que les autres titres du site (dégradé bleu horizontal 270deg
     + point final). Ici le point est une couleur pleine (--wf-orange-500), pas le dégradé
     vertical utilisé ailleurs, mesuré sur le bloc réel de la page équipe en prod. Centré à
     toutes les tailles (demande explicite de Paul) : le site réel aligne ce titre à gauche
     sur mobile, ce n'est pas voulu ici. */
  .wt-title {
    font-family: Allroundgothic, Arial, sans-serif;
    font-size: 3.2rem;
    line-height: 3.84rem;
    font-weight: 400;
    letter-spacing: -0.128rem;
    text-align: center;
    margin: 0;
    background: linear-gradient(270deg, var(--wf-blue-800), var(--wf-blue-600));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .wt-title-dot { color: var(--wf-orange-500); }
  @media screen and (max-width: 767px) {
    .wt-title { font-size: 3rem; line-height: 1; letter-spacing: -0.12rem; } /* design-system.md §2 : 3rem entre 480 et 767px, 2.5rem sous 480px */
  }

  /* Vidéo : iframe YouTube native (pas -nocookie, comme le bloc réel), pleine largeur du
     bloc. Ratio de padding-top repris tel quel de la vidéo réelle (56.17021276595745%,
     mesuré sur la page équipe en prod, ce n'est pas un 16:9 propre). Écart titre→vidéo
     de 1rem, mesuré sur le bloc réel. */
  .wt-video-frame {
    position: relative;
    width: 100%;
    margin-top: 1rem;
    padding-top: 56.17021276595745%;
    overflow: hidden;
  }
  .wt-video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  @media screen and (max-width: 479px) {
    .wt-title { font-size: 2.5rem; line-height: 1; letter-spacing: -0.1rem; }
  }
</style>
