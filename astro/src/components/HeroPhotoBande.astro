---
// Hero de page : titre H1 + intro + photo qui déborde sur une bande dégradée.
// Version composant du bloc pages/equipe/blocs/01-hero.html (même rendu, mêmes valeurs,
// couleurs lues dans les tokens --wf-*).
// Optionnels (ajoutés pour la page RSE, sans effet sur Équipe qui ne les passe pas) :
// un surtitre gris au-dessus du H1 et une rangée de chiffres clés sous l'intro.
interface Chiffre {
  valeur: string; // ex. "54"
  libelle: string; // ex. "e-NPS collaborateur"
}
interface Props {
  titre: string; // sans le point final : il est ajouté en orange
  intro: string; // HTML autorisé (passages en <span> mis en avant, <br>)
  photo: string;
  alt: string;
  surtitre?: string;
  chiffres?: Chiffre[];
  id?: string;
}
const { titre, intro, photo, alt, surtitre, chiffres = [], id = 'wt-hero' } = Astro.props;
---

<section class="wt-hero" id={id} aria-labelledby={`${id}-title`}>
  <div class="wt-inner">
    {surtitre && <p class="wt-hero-surtitre">{surtitre}</p>}
    <h1 class="wt-hero-title" id={`${id}-title`}>{titre}<span class="wt-hero-dot">.</span></h1>
    <p class="wt-hero-intro" set:html={intro} />
    {
      chiffres.length > 0 && (
        <ul class="wt-hero-chiffres">
          {chiffres.map((c) => (
            <li><span class="wt-hero-chiffre">{c.valeur}</span> {c.libelle}</li>
          ))}
        </ul>
      )
    }
    <div class="wt-hero-photo-frame">
      <div class="wt-hero-band"></div>
      <div class="wt-hero-photo">
        <img src={photo} alt={alt} loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .wt-hero {
    font-family: "Work Sans v2", Arial, sans-serif;
    margin: 3rem 0 5rem;
    box-sizing: border-box;
  }
  .wt-hero, .wt-hero :global(*), .wt-hero :global(*::before), .wt-hero :global(*::after) { box-sizing: border-box; }
  .wt-hero .wt-inner { max-width: 71.25rem; margin: 0 auto; padding: 0 1rem; box-sizing: border-box; }

  /* Titre H1 (pas H2 comme les autres blocs : c'est le titre principal de la page) :
     dégradé bleu horizontal + point orange, `color` orange en repli si le dégradé
     ne s'affiche pas. */
  .wt-hero-title {
    font-family: Allroundgothic, Arial, sans-serif;
    font-size: 4rem;
    line-height: 4rem;
    font-weight: 400;
    letter-spacing: -0.08rem;
    text-align: center;
    margin: 0;
    color: var(--wf-orange-600); /* repli si le dégradé ne s'affiche pas */
    background: linear-gradient(270deg, var(--wf-blue-800), var(--wf-blue-600));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .wt-hero-dot {
    background: linear-gradient(var(--wf-orange-600), var(--wf-orange-500));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .wt-hero-intro {
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.38rem;
    color: var(--wf-blue-800);
    text-align: center;
    max-width: 46rem;
    margin: 1.25rem auto 0;
  }
  /* Les passages mis en avant ne sont qu'en poids 500 (pas un vrai gras) et quasiment la
     même couleur que le reste, comme sur le site. Le HTML de l'intro vient de `set:html` :
     d'où `:global`, les <span> n'ont pas l'attribut de portée d'Astro. */
  .wt-hero-intro :global(span) { font-weight: 500; color: var(--wf-blue-900); }

  /* Surtitre (.h1lp du site : 14px, #a0a3bd) et chiffres clés (chiffre Work Sans 600 24px,
     libellé 14px, #002882), mesurés sur /notre-engagement-rse. */
  .wt-hero-surtitre { margin: 0 0 0.25rem; font-size: 0.875rem; line-height: 1.25rem; color: #a0a3bd; text-align: center; }
  .wt-hero-chiffres { list-style: none; margin: 2rem 0 0; padding: 0; display: flex; justify-content: center; gap: 3rem; }
  .wt-hero-chiffres li { font-size: 0.875rem; line-height: 1.25rem; color: var(--wf-blue-800); }
  .wt-hero-chiffre { font-size: 1.5rem; font-weight: 600; line-height: 1.5rem; margin-right: 0.25rem; }
  @media screen and (max-width: 767px) {
    .wt-hero-chiffres { flex-direction: column; align-items: center; gap: 0.75rem; }
  }

  @media screen and (max-width: 767px) {
    .wt-hero { margin-top: 0; } /* premier bloc de la page sur mobile : pas d'espace avant, demande explicite de Paul */
    .wt-hero-title { font-size: 2.5rem; line-height: 2.5rem; letter-spacing: -0.05rem; } /* design-system.md §2 : H1 2.5rem jusqu'à 767px, 2.8125rem sous 480px */
    .wt-hero-intro { font-size: 1.125rem; line-height: 1.35rem; }
  }
  /* Desktop : l'écart avec le bloc suivant est remonté à 7rem (demande de Paul), mobile inchangé. */
  @media screen and (min-width: 768px) {
    .wt-hero { margin-bottom: 7rem; }
  }

  /* Photo qui déborde sur une bande dégradée : la bande est positionnée par rapport à la
     photo elle-même (25% de sa hauteur, jusqu'à 3rem sous elle), pas par rapport à la page. */
  .wt-hero-photo-frame {
    position: relative;
    margin: 1.5rem 0 3rem;
  }
  .wt-hero-band {
    position: absolute;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    top: 25%;
    bottom: -3rem;
    background: linear-gradient(270deg, var(--wf-blue-800), var(--wf-blue-600));
  }
  .wt-hero-photo {
    position: relative;
    width: 100%;
    height: 25rem; /* hauteur fixe par palier plutôt qu'un ratio, comme le site */
    overflow: hidden;
    background: var(--wf-blue-50);
  }
  .wt-hero-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media screen and (max-width: 767px) {
    .wt-hero-photo-frame { margin: 1.25rem 0 2rem; }
    .wt-hero-photo { height: 11.25rem; }
    /* Sur mobile, la bande est alignée exactement sur la photo (pas de débord). */
    .wt-hero-band { top: 0; bottom: 0; }
  }
  @media screen and (max-width: 479px) {
    .wt-hero-title { font-size: 2.8125rem; line-height: 2.8125rem; }
  }
</style>
