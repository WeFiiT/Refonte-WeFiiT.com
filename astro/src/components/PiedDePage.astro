---
// Pied de page du site (footer natif Webflow reproduit) : appel au rendez-vous à gauche,
// liens sur deux rangées à droite, trois traits blancs en bas. Valeurs mesurées sur
// wefiit.com (fond #002882, padding 40px 0 15px, liens 12.8px 300 blancs). Le logo blanc
// et les icônes réseaux du footer d'origine sont masqués sur ordinateur : non repris.
const CDN = 'https://cdn.prod.website-files.com/63d687e3cca00b36190024ea/';
const RDV = 'https://outlook.office.com/book/WeFiiT2@wefiit.com/?ismsaljsauthenabled';
---

<footer class="wt-pied" aria-label="Pied de page">
  <div class="wt-bande">
    <div class="wt-inner">
      <div>
        <p class="wt-texte">Envie de travailler avec nous ?<br />Prenez rendez-vous directement dans notre agenda.</p>
        <a class="wt-rdv" href={RDV} target="_blank" rel="noopener">
          <span>Prendre rendez-vous</span>
          <img src={`${CDN}63d69d03bb2b54ad5d432ba8_arrow.svg`} alt="" />
        </a>
      </div>
      <div class="wt-liens">
        <div class="wt-rangee">
          <a href="/">Conseil Product Management</a>
          <a href="/product-management">Offre</a>
          <a href="/formation-product-management">Formation</a>
          <a href="https://wefiit.welcomekit.co/" target="_blank" rel="noopener">Nous&nbsp;rejoindre</a>
        </div>
        <div class="wt-rangee">
          <a href="/mentions-legales">Mentions&nbsp;légales</a>
          <a href={`${CDN}69a195e3bf3302d31b9d1e3f_WeFiiT%20-%20D%C3%A9claration%20Index%20Egalit%C3%A9.pdf`} target="_blank" rel="noopener">Index d'égalité professionnelle</a>
          <!-- Sur le site, « Cookies » ouvre le bandeau Axeptio : sans Axeptio, le lien ne fait rien. -->
          <a href="#" class="wt-cookies">Cookies</a>
        </div>
      </div>
    </div>
    <div class="wt-traits" aria-hidden="true"><span></span><span></span><span></span></div>
  </div>
</footer>

<style>
  .wt-pied { font-family: "Work Sans v2", Arial, sans-serif; margin: 0; box-sizing: border-box; }
  .wt-pied :global(*), .wt-pied :global(*::before), .wt-pied :global(*::after) { box-sizing: border-box; }
  .wt-bande {
    position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; width: 100vw;
    background: var(--wf-blue-800);
    padding: 2.5rem 0 0.9375rem;
  }
  .wt-inner { max-width: 70rem; margin: 0 auto; padding: 0 1rem 1.25rem; display: grid; grid-template-columns: 1fr 1.25fr; gap: 3.75rem 2.625rem; }

  .wt-texte { margin: 1rem 0 0; font-size: 1rem; line-height: 1.2rem; color: #dadde7; text-align: left; }
  .wt-rdv { display: inline-flex; align-items: center; gap: 0.625rem; margin-top: 1.25rem; text-decoration: none; }
  /* Lien texte (.link__texte) : .8rem, 700, majuscules, dégradé orange 90deg. */
  .wt-rdv span {
    font-size: 0.8rem; font-weight: 700; line-height: 1.25rem; text-transform: uppercase;
    background: linear-gradient(90deg, var(--wf-orange-500), var(--wf-orange-600));
    -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent;
  }
  .wt-rdv img { width: 1rem; height: auto; }

  .wt-liens { display: flex; flex-direction: column; justify-content: center; align-items: flex-end; gap: 0.3125rem; }
  .wt-rangee { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.625rem 1.3rem; }
  .wt-rangee a { font-size: 0.8rem; font-weight: 300; line-height: 1.5rem; letter-spacing: -0.0125rem; color: #fff; text-decoration: none; }
  .wt-rangee a:hover { text-decoration: underline; }

  /* Trois traits blancs de 2px pleine largeur, 20px d'écart (mesuré). */
  .wt-traits { margin-top: 0.625rem; }
  .wt-traits span { display: block; height: 2px; background: #fff; }
  .wt-traits span + span { margin-top: 1.25rem; }

  @media screen and (max-width: 767px) {
    .wt-inner { grid-template-columns: 1fr; gap: 2rem; }
    .wt-liens { align-items: flex-start; }
    .wt-rangee { justify-content: flex-start; }
  }
</style>

<script>
  // « Cookies » : ouvre le bandeau Axeptio s'il est chargé (c'est le cas sur wefiit.com).
  document.querySelectorAll<HTMLElement>('.wt-pied .wt-cookies').forEach((lien) => {
    lien.addEventListener('click', (e) => {
      e.preventDefault();
      const w = window as unknown as { openAxeptioCookies?: () => void };
      w.openAxeptioCookies?.();
    });
  });
</script>
