---
// Titre + intro, puis une barre d'onglets en pilule orange (une par tribe) qui affiche une
// carte : texte (objectif, Key Initiatives) à côté de la photo. Version composant du bloc
// pages/equipe/blocs/08-tribes.html (même rendu, même comportement, couleurs lues dans les
// tokens --wf-*).
// Sert aussi de composant d'onglets générique (ex. « Prendre soin » de la page RSE) grâce à
// des props optionnelles : sans elles, le rendu est exactement celui des Tribes.
//   - `etiquette` (par onglet) : texte au-dessus de l'objectif, « Tribe <nom> » par défaut,
//     chaîne vide = pas d'étiquette ;
//   - `titreListe` (global ou par onglet) : titre de la liste, « Key Initiatives » par défaut ;
//   - `alt` (par onglet) : description de la photo pour les lecteurs d'écran.
// Ids des onglets et des panneaux : ceux du bloc d'origine (wt-tab-N, wt-panel-N) avec l'id
// par défaut ; préfixés par `id` sinon, ce qui permet plusieurs instances sur une page.
interface Initiative {
  texte: string;
  invitation?: boolean; // vrai = icône « + » (place laissée à une idée du lecteur), sinon coche
}
interface Tribe {
  cle: string; // identifiant court, ex. "experience" (data-tribe)
  nom: string; // nom de l'onglet, repris dans « Tribe <nom> »
  objectif: string;
  initiatives: Initiative[];
  photo: string;
  etiquette?: string;
  titreListe?: string;
  alt?: string;
}
interface Props {
  titre: string; // sans le point final : il est ajouté en dégradé orange
  intro: string; // HTML autorisé (<strong>, <br>)
  tribes: Tribe[];
  titreListe?: string;
  aideDefilement?: string; // texte lu par les lecteurs d'écran au-dessus des onglets
  id?: string;
}
const {
  titre,
  intro,
  tribes,
  titreListe = 'Key Initiatives',
  aideDefilement = 'Faites glisser pour voir tous les tribes',
  id = 'wt-tribes',
} = Astro.props;
const prefixe = id === 'wt-tribes' ? 'wt' : id; // id par défaut : ids d'origine conservés
const idTitre = id === 'wt-tribes' ? 'wt-title-heading' : `${id}-titre`;
---

<section class="wt-tribes" id={id} aria-labelledby={idTitre}>
  <h2 class="wt-title" id={idTitre}>{titre}<span class="wt-title-dot">.</span></h2>
  <p class="wt-intro" set:html={intro} />

  <div class="wt-tabs-wrap">
    <span class="wt-sr-only">{aideDefilement}</span>
    <div class="wt-tabs" role="tablist">
      {
        tribes.map((t, i) => (
          <button
            type="button"
            id={`${prefixe}-tab-${i}`}
            class:list={['wt-tab', { 'is-active': i === 0 }]}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`${prefixe}-panel-${i}`}
            data-tab={i}
          >
            {t.nom}
          </button>
        ))
      }
    </div>
  </div>

  <div class="wt-panels">
    {
      tribes.map((t, i) => (
        <div
          class:list={['wt-panel', { 'is-active': i === 0 }]}
          id={`${prefixe}-panel-${i}`}
          role="tabpanel"
          aria-labelledby={`${prefixe}-tab-${i}`}
          data-panel={i}
        >
          <div class="wt-card">
            <div class="wt-text">
              {(t.etiquette ?? `Tribe ${t.nom}`) && <div class="wt-label"><span class="wt-line"></span>{t.etiquette ?? `Tribe ${t.nom}`}</div>}
              <p class="wt-objective">{t.objectif}</p>
              <div class="wt-ki-title">{t.titreListe ?? titreListe}</div>
              <ul class="wt-ki-list">
                {
                  t.initiatives.map((k) => (
                    <li>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                        <circle cx="12" cy="12" r="9.5" />
                        {k.invitation ? <path d="M12 8v8M8 12h8" /> : <path d="M8 12.3l2.5 2.5L16 9" />}
                      </svg>
                      {k.texte}
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="wt-photo-frame">
              <div class="wt-photo" data-tribe={t.cle} style={`background-image: url('${t.photo}')`} {...(t.alt ? { role: 'img', 'aria-label': t.alt } : {})} />
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .wt-tribes {
    font-family: "Work Sans v2", Arial, sans-serif;
    max-width: 71.25rem;
    margin: 0 auto 3.75rem; /* espace avant le bloc témoignage qui suit (09-temoignage-guillaume), qui porte la marge de fin du bloc */
    padding: 0 1rem;
    box-sizing: border-box;
  }
  .wt-sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  .wt-tribes, .wt-tribes :global(*), .wt-tribes :global(*::before), .wt-tribes :global(*::after) { box-sizing: border-box; }

  /* Titre + intro, même traitement que sur le bloc "S'épanouir grâce au collectif" :
     dégradé bleu horizontal sur le texte, point final en dégradé orange vertical
     séparé (vérifié sur les titres de rubrique réels du site, ex. "Paroles de
     WeFiiTers."). */
  .wt-title {
    font-family: Allroundgothic, Arial, sans-serif;
    font-size: 3.2rem;
    line-height: 3.84rem;
    font-weight: 400;
    letter-spacing: -0.128rem;
    text-align: center;
    margin: 0;
    background: linear-gradient(270deg, var(--wf-blue-800), var(--wf-blue-600));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .wt-title-dot {
    background: linear-gradient(var(--wf-orange-600), var(--wf-orange-500));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .wt-intro {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.3rem;
    color: var(--wf-blue-900);
    text-align: center;
    max-width: 46rem;
    margin: 1.125rem auto 3rem;
  }
  /* Le HTML de l'intro vient de `set:html` : d'où `:global` sur <strong>. */
  .wt-intro :global(strong) { font-weight: 600; }

  @media screen and (max-width: 767px) {
    .wt-title { font-size: 3rem; line-height: 1; letter-spacing: -0.12rem; } /* design-system.md §2 : 3rem entre 480 et 767px, 2.5rem sous 480px (règle en bas de feuille) */
  }

  /* Enveloppe des onglets : épouse la taille et la position de la pilule. */
  .wt-tabs-wrap {
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 3rem;
  }
  /* Onglets */
  .wt-tabs {
    display: flex;
    flex-wrap: nowrap; /* jamais de retour à la ligne : c'est lui qui créait des marges et des coins inégaux */
    justify-content: flex-start;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(to right, var(--wf-orange-500), var(--wf-orange-600));
    border-radius: 312.5rem;
    padding: 0.5rem; /* identique à la pilule de navigation réelle du site (.navigation-container-2) */
    width: 100%;
    overflow-x: auto; /* si ça ne tient pas, la barre défile au lieu de passer à la ligne */
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .wt-tabs::-webkit-scrollbar { display: none; }
  /* Pas de fondu de bord : l'onglet suivant reste volontairement visible en partie au bord
     (la barre ne passe jamais à la ligne et n'est pas centrée pour cacher le mot coupé),
     ce qui suffit à signaler « il y en a d'autres ». */
  .wt-tab {
    appearance: none;
    border: 0.0625rem solid transparent;
    cursor: pointer;
    background-color: transparent;
    color: #fff;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    padding: 0.25rem 1rem; /* identique au lien de navigation réel du site (.navigation-link-2) */
    line-height: 1.5rem;
    border-radius: 0.375rem;
    transition: 0.35s;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .wt-tab:hover { background-color: rgba(255,255,255,0.18); border-radius: 312.5rem; }
  .wt-tab.is-active { background-color: #fff; color: var(--wf-blue-900); border-radius: 312.5rem; }
  .wt-tab:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  /* Carte / panneaux */
  .wt-panel { display: none; }
  .wt-panel.is-active {
    display: block;
    animation: wt-fade 0.25s ease;
  }
  @keyframes wt-fade { from { opacity: 0; } to { opacity: 1; } }

  .wt-card {
    display: flex;
    align-items: stretch;
    gap: 2.75rem;
  }
  .wt-text {
    flex: 0 0 45%;
    max-width: 45%;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    background: #fff;
    border: 1px solid var(--wf-grey-100);
    border-radius: 0; /* design system : ce bloc reste un rectangle, sans coins arrondis */
    box-shadow: 1px 0 3px rgba(0,0,0,0.08); /* ombre de repos des cartes du site (design-system.md §5) */
  }
  /* Police, graisse, taille et couleur ci-dessous reprennent exactement le titre et le
     paragraphe de tribe du site réel (Work Sans v2, pas une police d'affichage) : gardés
     tels qu'ils sont sur wefiit.com plutôt que restylés. */
  .wt-label {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: inherit;
    color: var(--wf-blue-600);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .wt-label .wt-line { width: 1.5rem; height: 1px; background: var(--wf-blue-600); display: inline-block; }
  .wt-objective {
    font-family: inherit;
    color: var(--wf-blue-800);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.4;
    margin: 0;
  }
  .wt-ki-title {
    color: var(--wf-blue-300);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }
  .wt-ki-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .wt-ki-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--wf-blue-900);
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  /* Même couleur que les vraies icônes coche / plus du site (trait #001D84 = --wf-blue-900),
     pas le bleu plus vif --wf-blue-600. */
  .wt-ki-list svg { flex: none; color: var(--wf-blue-900); }

  .wt-photo-frame {
    flex: 0 0 calc(55% - 1rem);
    max-width: calc(55% - 1rem);
    position: relative;
  }
  .wt-photo-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--wf-blue-800);
    transform: translate(1rem, 1rem);
    z-index: 0;
  }
  /* L'image de fond (background-image) est posée en ligne sur l'élément, depuis la prop `photo`. */
  .wt-photo {
    position: relative;
    z-index: 1;
    height: 100%;
    width: 100%;
    background: var(--wf-blue-50);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Desktop uniquement : hauteur fixe pour que la carte et la photo ne changent jamais de
     taille quand on change d'onglet */
  @media screen and (min-width: 992px) {
    .wt-photo-frame { height: 26rem; }
  }

  /* Tablette et mobile : même traitement que le reste du site, un bloc dégradé derrière la
     photo, la photo elle-même se superposant par-dessus (pas une fine bordure décalée) */
  @media screen and (max-width: 991px) {
    /* Onglets : toujours pleine largeur et collés à gauche, jamais "fit-content" : c'est ce
       qui causait les trous et bords coupés quand la barre devait défiler */
    .wt-tabs-wrap { width: 100%; margin-bottom: 0.75rem; }
    .wt-tabs { justify-content: flex-start; }
    .wt-card { flex-direction: column; gap: 0; }
    .wt-text { flex: 1 1 auto; max-width: 100%; padding: 2rem; }

    /* Collé directement sous la carte de texte, sans écart : comme sur le site réel */
    .wt-photo-frame {
      flex: 1 1 auto;
      max-width: 100%;
      height: 21.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 0;
    }
    /* Même traitement que le site réel : le fond bleu sort à la pleine largeur de la fenêtre
       tandis que la photo garde la largeur du bloc de texte au-dessus, donc la bordure bleue
       visible a la même épaisseur à gauche, à droite et en bas. En plus, le fond est
       légèrement descendu (sans être redimensionné) pour se lire comme un calque décalé
       derrière la photo plutôt qu'un passe-partout collé. */
    .wt-photo-frame::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 1.25rem;
      bottom: -0.25rem;
      right: auto;
      transform: translateX(-50%);
      width: 100vw;
      height: auto;
      background: linear-gradient(to right, var(--wf-blue-900), var(--wf-blue-600));
    }
    .wt-photo {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 1rem;
      transform: none;
      width: auto;
      height: auto;
      z-index: 1;
    }
  }
  /* Mobile paysage : seuls l'espacement et la taille de la barre d'onglets changent, le
     défilement est déjà universel. Le padding vertical de .wt-tab reste intact pour que la
     pilule garde la même hauteur d'environ 48px que la navigation du site à tous les paliers ;
     seuls le padding horizontal et la taille de police rétrécissent un peu. */
  @media screen and (max-width: 767px) {
    .wt-tabs { gap: 0.375rem; padding: 0.375rem; margin-bottom: 0; }
    .wt-tab { padding: 0.25rem 0.875rem; font-size: 0.8125rem; }
    .wt-text { padding: 1.5rem; gap: 1rem; }
  }
  /* Mobile portrait */
  @media screen and (max-width: 479px) {
    .wt-tabs { padding: 0.3rem; gap: 0.3rem; }
    .wt-tab { padding: 0.25rem 0.75rem; font-size: 0.75rem; }
    .wt-photo-frame { height: 15rem; margin-top: 0; }
    .wt-text { padding: 1.25rem; }
  }
  @media screen and (max-width: 479px) {
    .wt-title { font-size: 2.5rem; line-height: 1; letter-spacing: -0.1rem; }
  }
</style>

<script>
  // Changement d'onglet : un seul panneau actif à la fois.
  document.querySelectorAll<HTMLElement>('.wt-tribes').forEach((root) => {
    if (root.getAttribute('data-wt-init') === '1') return;
    root.setAttribute('data-wt-init', '1');
    const tabs = root.querySelectorAll<HTMLElement>('.wt-tab');
    const panels = root.querySelectorAll<HTMLElement>('.wt-panel');
    const tabsBar = root.querySelector<HTMLElement>('.wt-tabs');
    // Empêche le navigateur de faire défiler la barre d'onglets de quelques px au chargement
    // (observé sur certains navigateurs mobiles), ce qui mangeait le padding gauche et
    // laissait un trou en croissant à côté du coin arrondi de la première pilule.
    if (tabsBar) tabsBar.scrollLeft = 0;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const index = tab.getAttribute('data-tab');
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach((p) => {
          p.classList.toggle('is-active', p.getAttribute('data-panel') === index);
        });
      });
    });
  });
</script>
