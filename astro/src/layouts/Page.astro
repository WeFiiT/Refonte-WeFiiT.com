---
import '../styles/tokens.css';

interface Props {
  titre: string;
}
const { titre } = Astro.props;

// Polices du site : mêmes fichiers que Webflow (même CDN que librairie/template.html).
// Sans elles, les titres s'afficheraient en Arial.
const CDN = 'https://cdn.prod.website-files.com/63d687e3cca00b36190024ea/';
const polices = `
@font-face{font-family:"Work Sans v2";src:url("${CDN}6685217fc3c9b3f73730a6c2_WorkSans-VariableFont_wght.ttf") format("truetype");font-weight:100 900;font-style:normal;font-display:swap}
@font-face{font-family:Allroundgothic;src:url("${CDN}63e424eda0e0796b48e27cd6_AllRoundGothic-Demi.otf") format("opentype");font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:Allroundgothic;src:url("${CDN}63e424e4a2e78bdb2b99bba7_AllRoundGothic-Bold.otf") format("opentype");font-weight:700;font-style:normal;font-display:swap}
body{margin:0;background:#fff;font-family:"Work Sans v2",Arial,sans-serif}
`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{titre}</title>
    <style is:inline set:html={polices}></style>
  </head>
  <body>
    <slot />
  </body>
</html>
