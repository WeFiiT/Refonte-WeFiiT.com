---
import '../styles/tokens.css';
import EnTete from '../components/EnTete';
import PiedDePage from '../components/PiedDePage';

// Toutes les pages ont le menu et le pied de page du site (navbar et footer natifs de
// Webflow, reproduits) : ils vivent ici, une seule fois, et non dans les blocs.
interface Props {
  titre: string;
  pageCourante?: string; // adresse de la page sur wefiit.com, marquée dans le menu
}
const { titre, pageCourante } = Astro.props;

// Polices du site (src/styles/polices.css, partagé avec le design system Claude Design),
// injectées en ligne dans le <head> pour qu'elles se chargent avant le reste.
import policesCss from '../styles/polices.css?raw';
const polices = `${policesCss}
body{margin:0;background:#fff;font-family:"Work Sans v2",Arial,sans-serif}
`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{titre}</title>
    <style is:inline set:html={polices}></style>
  </head>
  <body>
    <EnTete pageCourante={pageCourante} />
    <slot />
    <PiedDePage />
    <script>
      import '../comportements';
    </script>
  </body>
</html>
